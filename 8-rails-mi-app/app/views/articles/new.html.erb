<h1>Nuevo Articulo</h1>
<%= form_with(model: @article, local: true) do |form| %>
    <div>
        <%= form.label :title %>
        <%= form.text_field :title %>
    </div>
    <div>
        <%= form.label :content %>
        <%= form.text_area :content %>
    </div>
    <div>
        <%= form.submit "Crear Articulo" %>
    </div>
<% end %>

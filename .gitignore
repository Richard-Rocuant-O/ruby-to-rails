# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Rails app (8-rails-mi-app/)

# Ignore bundler config.
/8-rails-mi-app/.bundle

# Ignore all environment files.
/8-rails-mi-app/.env*

# Ignore all logfiles and tempfiles.
/8-rails-mi-app/log/*
/8-rails-mi-app/tmp/*
!/8-rails-mi-app/log/.keep
!/8-rails-mi-app/tmp/.keep

# Ignore pidfiles, but keep the directory.
/8-rails-mi-app/tmp/pids/*
!/8-rails-mi-app/tmp/pids/
!/8-rails-mi-app/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/8-rails-mi-app/storage/*
!/8-rails-mi-app/storage/.keep
/8-rails-mi-app/tmp/storage/*
!/8-rails-mi-app/tmp/storage/
!/8-rails-mi-app/tmp/storage/.keep

/8-rails-mi-app/public/assets

# Ignore key files for decrypting credentials and more.
/8-rails-mi-app/config/*.key

# Ignore vendored/installed gems if bundle path ever points inside the project
/8-rails-mi-app/vendor/bundle/
